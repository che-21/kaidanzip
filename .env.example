# MD2Short 환경 변수 예시 — 이 파일을 .env로 복사해 값을 채우세요. (.env는 git에 올라가지 않습니다)

# 필수: 내레이션 음성
ELEVENLABS_API_KEY=

# 선택: 자막 AI 분할, AI 장면 이미지
OPENAI_API_KEY=

# 선택: 웹 화면 GitHub 로그인 (두 값이 모두 있으면 로그인 켜짐)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# 쉼표로 구분한 허용 GitHub ID. 비어 있으면 아무도 로그인할 수 없습니다.
MD2SHORT_ALLOWED_GITHUB_USERS=
# OAuth App에 등록한 callback URL과 같아야 합니다.
MD2SHORT_PUBLIC_URL=http://localhost:8501
